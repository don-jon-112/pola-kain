# ==============================================================================
# POLAKAIN GARMENT SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Panduan:
# 1. Salin file ini menjadi .env
# 2. Buka Firebase Console (https://console.firebase.google.com/)
# 3. Buat Project baru atau pilih project yang sudah ada
# 4. Tambahkan Web App di menu Project Overview / Settings
# 5. Salin konfigurasi SDK Firebase ke variabel di bawah ini:
# ==============================================================================

# FIREBASE CONFIGURATION
VITE_FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=sistem-konveksi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sistem-konveksi
VITE_FIREBASE_STORAGE_BUCKET=sistem-konveksi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# OPTIONAL BACKEND API URL (Kosongkan jika menggunakan server bawaan atau Vercel full client)
VITE_API_URL=
